    <meta name="source_publisher" content="भृकुटी एकेडेमिक पब्लिकेशन्स्"></meta>
    <meta name="source_edition" content="दोस्रो (भृकुटी एकेडेमिक पब्लिकेशन्स्‌बाट पहिलो)"></meta>
    <meta name="source_year" content="२०५५"></meta>
    <meta name="source_isbn" content=""></meta>
    <meta name="book_about" content="जन्मोत्सव मुटुका थोपा ( कविता संग्रह) लेखकद्वय श्रीलक्ष्मीप्रसाद देवकोटा तथा श्रीमधुसूदन देवकोटाका कविताहरुको संकलन हो । यो पुस्तक सर्वप्रथम २०१५ सालमा निस्किएको भए तापनि यसमा परेका कविताहरु अगिल्लो विक्रम शताब्दीको अन्तिम दशकका उपज हुन् । &quot;जन्मोत्सव&quot;को रचनाकाल महाकवीको जन्म मितिमा पच्चिस थपेपछि स्वतः निस्किई हाल्दछ ।"></meta>
    <meta name="book_genre" content="कवितासङ्ग्रह"></meta>
